# MarketLab VN30 local product - copy to .env (never commit .env). scripts/Setup-MarketLab.ps1 does this for you.
# No secret below is real. Values in .env override nothing already set in the process environment.

# DEMO_OFFLINE  = public synthetic database (MarketLabVN30_Demo); read-only dashboard; EOD sync disabled.
# REAL_PRIVATE  = a REAL_PRIVATE database (e.g. MarketLabVN30_Live); requires MARKETLAB_SQL_DATABASE explicitly.
# The server refuses to serve data when the database's datasets do not match the mode (no automatic switch).
MARKETLAB_MODE=DEMO_OFFLINE

# SQL Server connection
MARKETLAB_SQL_SERVER=.
MARKETLAB_SQL_DATABASE=MarketLabVN30_Demo
MARKETLAB_SQL_DRIVER=ODBC Driver 18 for SQL Server
# windows = Windows Authentication (recommended locally); sql = SQL login (set USER/PASSWORD below)
MARKETLAB_SQL_AUTH=windows
MARKETLAB_SQL_USER=
MARKETLAB_SQL_PASSWORD=
# Local instance with self-signed certificate: Encrypt=yes + TrustServerCertificate=yes
MARKETLAB_SQL_ENCRYPT=yes
MARKETLAB_SQL_TRUST_SERVER_CERTIFICATE=yes
MARKETLAB_SQL_LOGIN_TIMEOUT=5
MARKETLAB_SQL_QUERY_TIMEOUT=60

# Ops (audit/runs) database, separate from the 13 business tables
MARKETLAB_OPS_DATABASE=MarketLabVN30_Ops

# Web server: loopback only (127.0.0.1 / localhost). LAN exposure is refused by configuration.
MARKETLAB_HOST=127.0.0.1
MARKETLAB_PORT=8000

# Secret for POST /api/ops/eod (>= 32 chars). Typed by the operator in the UI; never stored in JS/URL.
# Generate: scripts/Setup-MarketLab.ps1 (writes a random value into .env only).
MARKETLAB_OPS_TOKEN=

# REAL_PRIVATE database synced by scripts\Run-MarketLab-EOD.ps1 and the scheduled task (EOD never writes demo data).
# Independent of MARKETLAB_MODE above, so the dashboard can stay on DEMO_OFFLINE for presentations.
MARKETLAB_EOD_DATABASE=

# Real EOD provider: full path of a python.exe that has vnstock installed (installed by you from the
# vendor index, NOT inside this project's .venv). Example: C:\Users\<you>\AppData\Local\Programs\Python\Python312\python.exe
MARKETLAB_PROVIDER_PYTHON=
MARKETLAB_PROVIDER_TIMEOUT_SECONDS=180
MARKETLAB_PROVIDER_MAX_ATTEMPTS=3

# Asia/Ho_Chi_Minh. A scheduling setting only - NOT proof that the provider has finalized the session.
MARKETLAB_EOD_CUTOFF=16:10
MARKETLAB_MAX_BACKFILL_SESSIONS=40
# MARKETLAB_LOG_DIR=var\logs
